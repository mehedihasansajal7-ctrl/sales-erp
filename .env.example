# =============================================================================
# Integrated Sales / Order / Inventory / Delivery ERP - environment template
# Copy to `.env` and adjust. Never commit a real `.env`.
# =============================================================================

# --- Database ---------------------------------------------------------------
# Local development (docker compose db exposes 127.0.0.1:5433 on the host).
# `connection_limit` must be >= the number of concurrent requests a single
# instance can serve; `pool_timeout` is how long a request waits for a
# connection before failing.
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/sales_erp?schema=public&connection_limit=10&pool_timeout=20"
# Inside docker compose the app talks to the `db` service on the internal port:
# DATABASE_URL="postgresql://postgres:postgres@db:5432/sales_erp?schema=public&connection_limit=10&pool_timeout=20"

# Password of the PostgreSQL container. REQUIRED by docker compose: it refuses to
# start without it. Changing it later does NOT change an existing volume - set it
# before the very first start. Use a long random value in production.
POSTGRES_PASSWORD="postgres"

# Which host address the database port is published on. Keep 127.0.0.1 so the
# database is never reachable from the office LAN. Set to "0.0.0.0" only for a
# deliberate, temporary maintenance window.
DB_BIND_ADDRESS="127.0.0.1"

# --- Auth -------------------------------------------------------------------
# 32+ char random string used to sign the session cookie. REQUIRED by docker
# compose and checked again at startup in production.
# Generate:  openssl rand -base64 48
AUTH_SECRET="dev-only-secret-change-me-please-0123456789abcdef"
SESSION_MAX_AGE_SECONDS=43200

# --- Business configuration -------------------------------------------------
# Timezone used for every date boundary (overdue, today, weekly, id years).
APP_TIMEZONE="Asia/Dhaka"
# Enable the credit-limit warning during approval (with reason override). true|false
CREDIT_CHECK_ENABLED="true"
# Allow SALES_OPS to grant a delivery-priority override on a DO. true|false
PRIORITY_OVERRIDE_ENABLED="true"
# May a WAREHOUSE user dispatch less than the DO quantity? Default false: the
# warehouse only records vehicle/challan details and dispatches the full DO.
WAREHOUSE_PARTIAL_DISPATCH="false"
# Prefixes for generated document numbers (no separators inside the number).
# Sales order: SO19102026001, delivery order: DO19102026001,
# challan: CH19102026001 (date based).
ORDER_NO_PREFIX="SO"
DO_NO_PREFIX="DO"
CHALLAN_NO_PREFIX="CH"
TRANSFER_NO_PREFIX="TRF"
COUNT_NO_PREFIX="PC"

# --- Seed (development / demo only, NEVER in production) --------------------
# docker compose defaults SEED_ON_START to false. Set it to true only on a fresh
# demo machine. The seed also refuses to run once real orders exist.
SEED_ON_START="false"
SEED_DEFAULT_PASSWORD="demo1234"
SEED_ADMIN_EMAIL="admin@sales-erp.local"

# --- Backups ----------------------------------------------------------------
BACKUP_DIR="./backups"
BACKUP_KEEP_DAYS=14
